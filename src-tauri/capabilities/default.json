{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
        {
          "identifier": "shell:allow-execute",
          "allow": [
            {
              "name": "ffmpeg",
              "sidecar": true,
              "args": true
            },
            {
              "name": "binaries/ffmpeg",
              "sidecar": true,
              "args": true
            },
            {
              "name": "ffprobe",
              "sidecar": true,
              "args": true
            },
            {
              "name": "binaries/ffprobe",
              "sidecar": true,
              "args": true
            }
          ]
        }
  ]
}
