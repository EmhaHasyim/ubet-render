{
  "name": "ubet-render",
  "version": "0.4.2",
  "description": "Offline-first desktop renderer for looping video and audio playlists",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "bundle": "bun scripts/bundle.mjs",
    "release:prepare": "bun scripts/version.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "daisyui": "^5.7.50",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "browserslist": "^4.28.7",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,json,md}": [
      "oxfmt"
    ]
  },
  "allowScripts": {}
}
